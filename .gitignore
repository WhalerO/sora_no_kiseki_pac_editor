# Real game corpora are local integration-test inputs, not repository data.
test_raws/*
!test_raws/README.md

# Release archives and detached checksums are generated artifacts.
*.zip
*.7z
*.sha256

# LibVLC is supplied locally for reproducible Windows builds. Keep its
# documentation in Git, but never commit the large native runtime itself.
_vendor/libvlc/win-x64/*
!_vendor/libvlc/win-x64/README.md
